              "path": [
                "api",
                "products",
                "1"
              ]
            },
            "description": "Edita los datos de un producto existente. Requiere token de rol Administrador."
          },
          "response": []
        },
        {
          "name": "Eliminar Producto",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products",
                "1"
              ]
            },
            "description": "Elimina un producto del inventario. Requiere token de rol Administrador."
          },
          "response": []
        }
      ]
    }
